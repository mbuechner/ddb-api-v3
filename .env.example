# Lokale Konfiguration: als .env kopieren; gesetzte Prozessvariablen haben Vorrang.
# Produktive Secrets extern verwalten. Beide Dateien verwenden dieselbe Gruppierung.

# =============================================================================
# GEMEINSAM: Profil und Schreibschutz fuer API UND Gateway
# =============================================================================
# dev: lokales Gateway-Limit ohne Redis. prod: gemeinsames Redis; Speicher immer S3.
APP_PROFILE=dev
# Nur dev: 32 zufaellige Bytes als Base64URL, 43 Zeichen ohne Padding. Leer sperrt Writes.
# Beide Komponenten brauchen denselben Wert. Erzeugung und Rotation: docs/security.md.
DDB_DEV_WRITE_TOKEN=
# Produktiv: Issuer und Audience gemeinsam setzen, Dev-Token leeren; JWKS optional.
OAUTH2_ISSUER_URI=
OAUTH2_AUDIENCE=
OAUTH2_JWK_SET_URI=

# =============================================================================
# DDB_API: HTTP und RDF
# =============================================================================
# Freie, unterschiedliche Werte fuer DDB_API_PORT und GATEWAY_PORT waehlen.
DDB_API_PORT=8080
# auto oder oeffentlicher Origin ohne /3; bestimmt Graphnamen und relative RDF/XML-IRIs.
DDB_API_BASE_URL=auto
# Nur hinter einem vertrauenswuerdigen, Header bereinigenden Proxy aktivieren.
DDB_API_FORWARD_HEADERS_STRATEGY=none
# Bei aktivierter Auswertung: rfc-7239 fuer Forwarded oder x-forwarded fuer X-Forwarded-*.
DDB_API_FORWARD_HEADERS_NAMING=rfc-7239
# Grenze nach gzip-Dekomprimierung; gilt vor RDF-Validierung und Speicherung.
DDB_API_UPLOAD_MAX_FILE_SIZE=1MB
DDB_API_COMPRESSION_ENABLED=true
DDB_API_COMPRESSION_MIN_RESPONSE_SIZE=1KB

# DDB_API: aktive RDF-Arbeit, begrenzte Warteschlange; bei Ueberlast 503.
# Virtual Threads ersetzen kein RAM-Budget fuer Graphen. Health/Dokumentation bleiben erreichbar.
DDB_API_MAX_CONCURRENT_REQUESTS=32
DDB_API_MAX_QUEUED_REQUESTS=64
DDB_API_QUEUE_TIMEOUT=1s

# DDB_API: strukturierte Logs und Header fuer die protokollierte Client-ID.
# Access-Logs ohne Sampling; keine Bodies, Secrets oder Query-Strings. Siehe docs/logging.md.
DDB_API_LOG_FORMAT=ecs
DDB_API_ACCESS_LOG_ENABLED=true
DDB_API_ACCESS_LOG_LEVEL=INFO
# Teilzeiten im Access-Event; Schwelle markiert langsame Requests, filtert aber keine Events.
DDB_API_PERFORMANCE_LOG_ENABLED=true
DDB_API_SLOW_REQUEST_THRESHOLD=100ms
# Fuer dieselbe Header-ID an beiden Hops mit GATEWAY_CLIENT_ID_HEADER_NAME abstimmen.
DDB_API_CLIENT_ID_HEADER_NAME=X-Client-Id

# =============================================================================
# DDB_API: S3-Speicher
# =============================================================================
# Beide Profile verwenden S3. Lokal vorher SeaweedFS starten; Compose nutzt intern seaweedfs:8333.
# Endpoint: HTTP(S)-Origin ohne Bucket-Pfad, Query oder Zugangsdaten; getrennt von DDB_API_BASE_URL.
# Kontounterlagen: AWS_ENDPOINT_URL -> DDB_API_S3_ENDPOINT,
# AWS_ACCESS_KEY_ID -> DDB_API_S3_ACCESS_KEY, AWS_SECRET_ACCESS_KEY -> DDB_API_S3_SECRET_KEY.
DDB_API_S3_ENDPOINT=http://127.0.0.1:8333
# Nur Compose: auf dem Rechner veroeffentlichter Port des lokalen S3-Dienstes.
DDB_API_S3_HOST_PORT=8333
DDB_API_S3_REGION=eu-central-1
DDB_API_S3_BUCKET=ddb-records
# Oeffentliche Beispielzugangsdaten nur lokal; Speicherkonto und API gemeinsam konfigurieren.
DDB_API_S3_ACCESS_KEY=ddb-dev
DDB_API_S3_SECRET_KEY=ddb-dev-secret
DDB_API_S3_PATH_STYLE_ACCESS=true
DDB_API_S3_CONNECTION_TIMEOUT=2s
DDB_API_S3_READ_TIMEOUT=10s
# SDK-Verbindungspool; auf eine Verbindung wird maximal CONNECTION_TIMEOUT gewartet.
DDB_API_S3_MAX_CONNECTIONS=50
# Produktiv false: vorhandener Bucket, Objekt-Rechte und HeadBucket-Zugriff erforderlich.
DDB_API_S3_CREATE_BUCKET=true

# =============================================================================
# GATEWAY: HTTP, API-Ziel und Verbindungspool
# =============================================================================
# Listener und veroeffentlichter Compose-Port sind identisch.
GATEWAY_PORT=8081
# Java/Maven: Default folgt DDB_API_PORT. Feste/externe Adresse hier explizit setzen.
# Compose setzt sein internes Ziel selbst auf api-service:DDB_API_PORT.
GATEWAY_API_SERVICE_URI=http://127.0.0.1:${DDB_API_PORT}
GATEWAY_FORWARD_HEADERS_STRATEGY=none
GATEWAY_FORWARD_HEADERS_NAMING=rfc-7239
# Warteschlange: doppelte Poolgroesse, maximal eine Sekunde Warten.
GATEWAY_HTTP_MAX_CONNECTIONS=256

# GATEWAY: Logs; Nutzungsstatistiken hier zaehlen, API-Events separat fuer Backend-Performance.
GATEWAY_LOG_FORMAT=ecs
GATEWAY_ACCESS_LOG_ENABLED=true
GATEWAY_ACCESS_LOG_LEVEL=INFO
# Ein korrelierbares http.performance-Event je Request, getrennt vom nativen Access-Log.
GATEWAY_PERFORMANCE_LOG_ENABLED=true
GATEWAY_SLOW_REQUEST_THRESHOLD=100ms

# GATEWAY: Bucket4j-Quoten. Nur das Zustands-Backend haengt vom Profil ab.
GATEWAY_RATE_LIMIT_REPLENISH_RATE=10
GATEWAY_RATE_LIMIT_REFILL_PERIOD=1s
GATEWAY_RATE_LIMIT_BURST_CAPACITY=20
GATEWAY_RATE_LIMIT_REQUESTED_TOKENS=1

# GATEWAY: gepruefter Principal zuerst; optional lokaler Header; anonyme Quote je Socket-IP.
# Im Profil prod ohne explizite Vorgabe kein Header-Fallback. Header erteilt keine Schreibrechte.
GATEWAY_CLIENT_ID_HEADER_ENABLED=true
GATEWAY_CLIENT_ID_HEADER_NAME=X-Client-Id
GATEWAY_ANONYMOUS_RATE_LIMIT_BY_REMOTE_ADDRESS=true

# =============================================================================
# GATEWAY: Redis (nur prod; dev benoetigt kein Redis)
# =============================================================================
GATEWAY_REDIS_HOST=127.0.0.1
GATEWAY_REDIS_PORT=6379
GATEWAY_REDIS_USERNAME=
# In prod erforderlich; produktive Zugangsdaten aus dem Secret Store beziehen.
GATEWAY_REDIS_PASSWORD=
GATEWAY_REDIS_TLS_ENABLED=true
GATEWAY_REDIS_CONNECT_TIMEOUT=500ms
GATEWAY_REDIS_COMMAND_TIMEOUT=500ms

# GATEWAY: optional Sentinel ueber native Spring-Boot-Variablen, ohne eigenes Zusatzprofil.
# Diese Framework-Namen bleiben absichtlich unveraendert; keine leeren Sentinel-Werte aktivieren.
# SPRING_DATA_REDIS_SENTINEL_MASTER=ddb-api-v3
# SPRING_DATA_REDIS_SENTINEL_NODES=sentinel-1.example:26379,sentinel-2.example:26379,sentinel-3.example:26379
# SPRING_DATA_REDIS_SENTINEL_USERNAME=
# SPRING_DATA_REDIS_SENTINEL_PASSWORD=

# Produktion: APP_PROFILE=prod, DDB_API_S3_CREATE_BUCKET=false, vorhandenes S3-Konto und
# Gateway-Redis konfigurieren. S3 muss atomare bedingte PUTs (If-Match/If-None-Match) erlauben.
# Externes S3 funktioniert auch in dev; prod aktiviert zusaetzlich verteilte Gateway-Limits.
