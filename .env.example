# Lokale Konfiguration. Als `.env` kopieren; bereits gesetzte Prozessvariablen
# haben Vorrang. Produktive Secrets gehören ausschließlich in den Secret Store.

# Dasselbe Profil gilt immer für API-Service und Gateway:
# `dev` = H2 + Caffeine, `prod` = Cassandra + Redis.
APP_PROFILE=dev

# Lokale HTTP-Ports. Der API-Service wird im Compose-Netz nur vom Gateway erreicht.
SERVER_PORT=8080
GATEWAY_PORT=8081
GATEWAY_HOST_PORT=8081

# Öffentliche Adresse, unter der dieser API-Deployment von Clients erreichbar ist.
# Sie bildet ausschließlich API-eigene JSON-LD-IRIs wie Context, CatalogRecord
# und angewendetes Validierungsprofil. Lokale Entwicklung darf localhost nutzen.
# Erlaubt ist eine absolute HTTP(S)-URL ohne Benutzerinfo, Query oder Fragment.
DDB_API_PUBLIC_BASE_URL=http://localhost:8081

# Globale, deployment-unabhängige Basis für fachliche DDB-Ressourcen. Der Service
# ergänzt je nach Ressourcentyp `/item/{recordId}`, `/dataset/{datasetId}` oder
# `/organization/{providerId}`. Alle drei IDs sind eigenständige 32-stellige DDB-IDs.
# Der Wert darf einen gemeinsamen Pfad enthalten, aber keinen Query oder Fragment.
DDB_RESOURCE_BASE_URL=https://www.deutsche-digitale-bibliothek.de

# Vorbereitete fachliche Obergrenze; die OpenAPI-Limits bleiben derzeit maßgeblich.
DDB_API_MAX_RECORDS=10000

# Jetty accepts gzip request bodies and compresses eligible responses from this size.
DDB_API_COMPRESSION_ENABLED=true
DDB_API_COMPRESSION_MIN_RESPONSE_SIZE=1KB

# Technische Obergrenzen fuer einen einzelnen Multipart-Teil und den gesamten
# Upload-Request. Spring akzeptiert die ueblichen Datengroessen wie KB, MB und GB.
DDB_API_UPLOAD_MAX_FILE_SIZE=1MB
DDB_API_UPLOAD_MAX_REQUEST_SIZE=10MB

# Lokale H2-Dateidatenbank. Ein relativer Pfad wird gegen das Arbeitsverzeichnis
# des API-Service aufgelöst. Die Endungen `.mv.db` und `.trace.db` ergänzt H2
# selbst. Docker Compose verwendet stattdessen automatisch `/app/data/ddb-api-v3`
# in einem benannten Volume. Benutzer und Passwort gelten nur für den lokalen
# Entwicklungszugriff; im Produktionsprofil wird H2 vollständig deaktiviert.
H2_DATABASE_PATH=./data/ddb-api-v3
H2_DATABASE_USERNAME=sa
H2_DATABASE_PASSWORD=

# Aktiviert die lokale Browser-Konsole unter http://localhost:8080/h2-console.
# Die Konsole akzeptiert nur Zugriffe vom selben Rechner und wird von Compose
# deaktiviert. Als JDBC URL ist `jdbc:h2:file:./data/ddb-api-v3` einzutragen.
H2_CONSOLE_ENABLED=true

# Redis-Verbindung ausschließlich für `prod`; in der Entwicklung werden diese
# Einstellungen ignoriert. Zugangsdaten gehören in den Secret Store.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS_ENABLED=true
REDIS_CONNECT_TIMEOUT=500ms
REDIS_COMMAND_TIMEOUT=500ms

# Bucket4j: Token pro Auffüllintervall, maximale Bucket-Größe und
# Tokenkosten pro Request. Nur das Zustands-Backend hängt vom Profil ab.
RATE_LIMIT_REPLENISH_RATE=10
RATE_LIMIT_REFILL_PERIOD=1s
RATE_LIMIT_BURST_CAPACITY=20
RATE_LIMIT_REQUESTED_TOKENS=1

# Nur lokal darf eine syntaktisch validierte Client-ID aus diesem Header kommen.
# Im Profil `prod` ist der Header-Fallback deaktiviert; dort gilt der Principal.
CLIENT_ID_HEADER_ENABLED=true
CLIENT_ID_HEADER_NAME=X-Client-Id
ANONYMOUS_RATE_LIMIT_BY_REMOTE_ADDRESS=true

# Ziel des API-Service beim separat gestarteten Gateway. Compose setzt diese URL
# intern selbst auf den Service-Namen `api-service`.
API_SERVICE_URI=http://127.0.0.1:8080

# -----------------------------------------------------------------------------
# Produktion (`APP_PROFILE=prod`): externe Cassandra
# -----------------------------------------------------------------------------

# Kommagetrennte Startknoten im Format host:port. Mindestens zwei Kontaktpunkte
# vermeiden die Abhängigkeit von einem einzelnen Knoten.
# CASSANDRA_CONTACT_POINTS=cassandra-1.example:9042,cassandra-2.example:9042

# Das lokale Cassandra-Datacenter für token-aware Routing und LOCAL_QUORUM.
# CASSANDRA_LOCAL_DATACENTER=dc1

# Produktiver Keyspace; das Referenzschema unter
# api-service/src/main/resources/db/cassandra/schema.cql wird separat angewendet.
# CASSANDRA_KEYSPACE=ddb_api_v3

# Zugangsdaten ausschließlich als Deployment-Secrets setzen.
# CASSANDRA_USERNAME=
# CASSANDRA_PASSWORD=

# Treiber-Timeouts und Backpressure. Zeitwerte benötigen eine Einheit.
# CASSANDRA_CONNECT_TIMEOUT=5s
# CASSANDRA_INIT_QUERY_TIMEOUT=5s
# CASSANDRA_REQUEST_TIMEOUT=2s
# CASSANDRA_CONSISTENCY=LOCAL_QUORUM
# CASSANDRA_MAX_CONCURRENT_REQUESTS=1024
# CASSANDRA_MAX_QUEUED_REQUESTS=2048

# Produktives Redis kann über einen stabilen Managed-Service-Endpunkt angebunden
# werden. REDIS_PASSWORD und DDB_API_PUBLIC_BASE_URL sind im Profil `prod`
# verpflichtend. Für DDB_RESOURCE_BASE_URL gilt der oben dokumentierte kanonische
# DDB-Default. TLS sollte aktiviert sein.

# Alternativ aktiviert Spring Boot Sentinel direkt, sobald diese nativen
# Einstellungen gesetzt sind. Ein zusätzliches Spring-Profil ist nicht nötig.
# SPRING_DATA_REDIS_SENTINEL_MASTER=ddb-api-v3
# SPRING_DATA_REDIS_SENTINEL_NODES=sentinel-1.example:26379,sentinel-2.example:26379,sentinel-3.example:26379
# SPRING_DATA_REDIS_SENTINEL_PASSWORD=
