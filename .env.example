# Lokale Konfiguration. Als `.env` kopieren; bereits gesetzte Prozessvariablen
# haben Vorrang. Produktive Secrets gehören ausschließlich in den Secret Store.

# Dasselbe Profil gilt immer für API-Service und Gateway:
# Speicherung immer S3; Gateway-Rate-Limit lokal mit Caffeine (`dev`),
# verteilt mit Redis (`prod`). Beide speichern keine RDF-Antworten.
APP_PROFILE=dev

# Schreibschutz für POST/PUT: nur im Profil dev, niemals prod.
# Leer = Schreiben gesperrt. 32 kryptographisch zufällige Bytes als Base64URL ohne Padding.
# Token lokal erzeugen (siehe docs/security.md), hier einsetzen und beide Apps neu starten.
# Bei Anfragen: Authorization: Bearer <Token>. Nicht als X-Client-Id senden.
# Kein Beispiel-Token und kein eingebautes Passwort werden akzeptiert.
DDB_DEV_WRITE_TOKEN=

# Spätere Produktion mit OAuth2/OIDC, z.B. Keycloak: Issuer UND Audience gemeinsam setzen.
# Den Dev-Token dafür leeren. Die JWKS-URL ist optional bei OIDC-Discovery.
# API und Gateway prüfen Signatur, Issuer, Audience, exp, sub und records:write.
OAUTH2_ISSUER_URI=
OAUTH2_AUDIENCE=
OAUTH2_JWK_SET_URI=

# Lokale HTTP-Ports. Der API-Service wird im Compose-Netz nur vom Gateway erreicht.
SERVER_PORT=8080
GATEWAY_PORT=8081
GATEWAY_HOST_PORT=8081

# Strukturierte JSON-Logs (Elastic Common Schema) auf stdout, in beiden Anwendungen.
# Ein Access-Event pro abgeschlossener Anfrage, ohne Sampling; Dauer in Nanosekunden.
# Nutzungsstatistik aus den Gateway-Events, API-Events separat für Backend-Performance.
# Enthält Socket-IP, validierte Header-Client-ID, Status, Pfad und Antwortformat;
# keine Query-Strings, Bodies, Authorization- oder Cookie-Header. Details: docs/logging.md.
LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs
DDB_ACCESS_LOG_ENABLED=true
# Access-Events bleiben INFO, auch wenn das allgemeine Log-Level höher gesetzt wird.
LOGGING_LEVEL_DE_DDB_APIV3_ACCESS=INFO
# IP-Adressen: source.ip bleibt der Socket-Peer; client.ip folgt standardmäßig ebenfalls ihm.
# Nur hinter einem exklusiven, Header bereinigenden Proxy auf native setzen.
SERVER_FORWARD_HEADERS_STRATEGY=none

# Öffentliche Basis-URL für Named Graphs und relative RDF/XML-IRIs, immer ohne /3.
# auto = Schema, Host und Port der HTTP-Anfrage; der Pfad /3 wird nicht übernommen.
# Alternativ einen festen öffentlichen HTTP(S)-Origin setzen, z.B. https://api.example.org.
# Eine feste Vorgabe bleibt auch hinter Proxies unverändert. dev verwendet ohne Vorgabe
# auto, prod weiterhin https://api.deutsche-digitale-bibliothek.de.
DDB_API_BASE_URL=auto

# Jetty accepts gzip request bodies and compresses eligible responses from this size.
DDB_API_COMPRESSION_ENABLED=true
DDB_API_COMPRESSION_MIN_RESPONSE_SIZE=1KB

# Maximale Größe eines RDF-Dokuments nach einer eventuellen gzip-Dekomprimierung.
# Akzeptiert Datengrößen wie KB, MB und GB; wird vor der Speicherung geprüft.
DDB_API_UPLOAD_MAX_FILE_SIZE=1MB

# Pro API-Instanz: aktive RDF-Anfragen, begrenzte Warteschlange und maximale Wartezeit.
# Mehr Virtual Threads ersetzen kein RAM-Budget für RDF-Graphen. Bei Überlast: 503.
# Health-Probes und Dokumentation bleiben erreichbar. Mit CPU/RAM gemeinsam skalieren.
DDB_API_MAX_CONCURRENT_REQUESTS=32
DDB_API_MAX_QUEUED_REQUESTS=64
DDB_API_QUEUE_TIMEOUT=1s

# Beide Profile verwenden einen S3-kompatiblen Objektspeicher. Lokal stellt Compose
# SeaweedFS bereit: vor dem Maven-Start `docker compose up -d seaweedfs` ausführen.
# Für ein vorhandenes Service-Konto die vom Anbieter gelieferten WERTE zuordnen:
#   AWS_ENDPOINT_URL      -> S3_ENDPOINT
#   AWS_ACCESS_KEY_ID     -> S3_ACCESS_KEY
#   AWS_SECRET_ACCESS_KEY -> S3_SECRET_KEY
# Die Anwendung verwendet hier die S3_*-Namen; die AWS_*-Bezeichnungen stammen
# aus den Kontounterlagen. Zusätzlich wird der freigegebene Bucket benötigt.
# S3_ENDPOINT ist die HTTP(S)-Basisadresse ohne Bucket-Pfad, Query oder Zugangsdaten.
# Sie ist unabhängig von DDB_API_BASE_URL, das die öffentlichen Graphnamen bestimmt.
# Maven/JAR liest diese Werte aus .env. Gesetzte Prozessvariablen haben Vorrang.
# Compose verwendet für seinen API-Service den lokalen Endpunkt http://seaweedfs:8333.
S3_ENDPOINT=http://127.0.0.1:8333
S3_HOST_PORT=8333
S3_REGION=eu-central-1
S3_BUCKET=ddb-records
# Öffentliche Beispiel-Zugangsdaten ausschließlich für die lokale Entwicklung.
# Der lokale Compose-Speicher übernimmt diese beim ersten Start. Für eigene
# Zugangsdaten das Speicherkonto und die API-Konfiguration gemeinsam aktualisieren.
S3_ACCESS_KEY=ddb-dev
S3_SECRET_KEY=ddb-dev-secret
S3_PATH_STYLE_ACCESS=true
S3_CONNECTION_TIMEOUT=2s
S3_READ_TIMEOUT=10s
# Geteilter SDK-Verbindungspool pro API-Instanz; keine Daten-/Antwortzwischenspeicherung.
# Auf eine freie Verbindung wird höchstens S3_CONNECTION_TIMEOUT gewartet.
S3_MAX_CONNECTIONS=50
# Lokal darf die Anwendung den Bucket anlegen. In Produktion false setzen und
# den Bucket einschließlich Zugriffsrechten vorab durch den Storage-Betrieb anlegen.
S3_CREATE_BUCKET=true

# Redis-Verbindung ausschließlich für `prod`; in der Entwicklung werden diese
# Einstellungen ignoriert. Zugangsdaten gehören in den Secret Store.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS_ENABLED=true
REDIS_CONNECT_TIMEOUT=500ms
REDIS_COMMAND_TIMEOUT=500ms

# Bucket4j: Token pro Auffüllintervall, maximale Bucket-Größe und
# Tokenkosten pro Request. Nur das Zustands-Backend hängt vom Profil ab.
RATE_LIMIT_REPLENISH_RATE=10
RATE_LIMIT_REFILL_PERIOD=1s
RATE_LIMIT_BURST_CAPACITY=20
RATE_LIMIT_REQUESTED_TOKENS=1

# Nur lokal darf eine syntaktisch validierte Client-ID aus diesem Header kommen.
# Im Profil `prod` ist der Header-Fallback deaktiviert; dort gilt der Principal.
CLIENT_ID_HEADER_ENABLED=true
CLIENT_ID_HEADER_NAME=X-Client-Id
ANONYMOUS_RATE_LIMIT_BY_REMOTE_ADDRESS=true

# Ziel des API-Service beim separat gestarteten Gateway. Compose setzt diese URL
# intern selbst auf den Service-Namen `api-service`.
API_SERVICE_URI=http://127.0.0.1:8080
# Pro Gateway: maximal so viele gepoolte Upstream-Verbindungen; die Warteschlange
# ist auf das Doppelte begrenzt, die Wartezeit auf eine Verbindung auf eine Sekunde.
GATEWAY_HTTP_MAX_CONNECTIONS=256

# -----------------------------------------------------------------------------
# Produktion (`APP_PROFILE=prod`): externer S3-kompatibler Objektspeicher
# -----------------------------------------------------------------------------

# Beispiel für ein vorhandenes Service-Konto: die aktiven lokalen Werte OBEN
# ersetzen. Die Platzhalter durch die Werte des Kontos und den Bucket-Namen ersetzen.
# S3_ENDPOINT=https://s3.example.internal
# S3_ACCESS_KEY=<Wert von AWS_ACCESS_KEY_ID>
# S3_SECRET_KEY=<Wert von AWS_SECRET_ACCESS_KEY>
# S3_REGION=eu-central-1
# S3_BUCKET=<freigegebener-bucket>
# S3_CREATE_BUCKET=false
# Der Endpoint ist der Wert von AWS_ENDPOINT_URL aus den Kontounterlagen.
# Ein bestehender Bucket wird nicht erneut angelegt: S3_CREATE_BUCKET=false.
# Das Konto benötigt Objekt-Lese-/Schreibrechte und Zugriff für HeadBucket
# (Bucket-Prüfung der Readiness-Probe). Bucket-Anlegerechte sind dann nicht nötig.
# Der externe Speicher kann auch im Profil dev für Maven/JAR verwendet werden;
# prod aktiviert zusätzlich das Redis-Backend des Gateways.
# Produktive Zugangsdaten ausschließlich über Deployment-Secrets setzen.
# Die lokalen Beispielwerte oben dürfen nicht in Produktion übernommen werden.
# Der Speicher muss atomare bedingte PUTs mit If-Match und If-None-Match
# unterstützen. Die lokale Compose-Umgebung verwendet SeaweedFS 4.53.

# Produktives Redis kann über einen stabilen Managed-Service-Endpunkt angebunden
# werden. REDIS_PASSWORD ist im Profil `prod` verpflichtend. TLS sollte aktiviert sein.

# Alternativ aktiviert Spring Boot Sentinel direkt, sobald diese nativen
# Einstellungen gesetzt sind. Ein zusätzliches Spring-Profil ist nicht nötig.
# SPRING_DATA_REDIS_SENTINEL_MASTER=ddb-api-v3
# SPRING_DATA_REDIS_SENTINEL_NODES=sentinel-1.example:26379,sentinel-2.example:26379,sentinel-3.example:26379
# SPRING_DATA_REDIS_SENTINEL_PASSWORD=
