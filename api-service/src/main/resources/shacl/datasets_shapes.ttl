# DATASETS – SHACL Core: bewusst konservative Startregeln.
# Diese Datei behauptet keine vollständige fachliche Konformitätsprüfung.
# Die Klassendefinitionen gehören für RDFS-basierte Target-Auswahl ggf. in den Datengraphen.

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix ddbv: <https://www.deutsche-digitale-bibliothek.de/ddb/validation/> .

# Gültiger RDF-Verweis; keine verbindliche Pflicht zur Distribution abgeleitet.
ddbv:DatasetDistributionLinkShape a sh:NodeShape ;
  sh:targetClass dcat:Dataset ;
  sh:property [ sh:path dcat:distribution ; sh:nodeKind sh:IRIOrBlankNode ] .
