@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <urn:ddb:shapes:items:> .

# Keep item rules independent of records, even while both only require a nonempty graph.
# The fixed target prevents empty data from evading validation by having no target subjects.
shapes:NonEmptyGraph a sh:NodeShape ;
    sh:targetNode <urn:ddb:validation:graph> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The RDF graph must contain at least one triple." ;
        sh:select "SELECT $this WHERE { FILTER NOT EXISTS { ?s ?p ?o } }"
    ] .
