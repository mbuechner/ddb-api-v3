    },
    "wasInvalidatedBy": {
      "@id": "prov:wasInvalidatedBy",
      "@type": "@id"
    },
    "type": {
      "@id": "dcterms:type",
      "@type": "@id"
    },
    "title": "dcterms:title",
    "description": "dcterms:description",
    "name": "foaf:name",
    "publisher": {
      "@id": "dcterms:publisher",
      "@type": "@id"
    },
    "license": {
      "@id": "dcterms:license",
      "@type": "@id"
    },
    "dataset": {
      "@id": "dcat:dataset",
      "@type": "@id",
      "@container": "@set"
    },
    "service": {
