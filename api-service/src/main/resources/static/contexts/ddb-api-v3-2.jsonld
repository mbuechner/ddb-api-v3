    },
    "endpointURL": {
      "@id": "dcat:endpointURL",
      "@type": "@id"
    },
    "distribution": {
      "@id": "dcat:distribution",
      "@container": "@set",
      "@type": "@id"
    },
    "accessURL": {
      "@id": "dcat:accessURL",
      "@type": "@id"
    },
    "mediaType": {
      "@id": "dcat:mediaType",
      "@type": "@id"
    },
    "packageFormat": {
      "@id": "dcat:packageFormat",
      "@type": "@id"
    },
    "bf": "http://id.loc.gov/ontologies/bibframe/",
    "edm": "http://www.europeana.eu/schemas/edm/",
    "dc": "http://purl.org/dc/elements/1.1/",
    "isPrimaryTopicOf": {
      "@id": "foaf:isPrimaryTopicOf",
      "@type": "@id",
      "@container": "@set"
    },
