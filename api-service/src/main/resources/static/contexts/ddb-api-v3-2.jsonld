      "@type": "@id"
    },
    "notation": {
      "@id": "skos:notation",
      "@type": "xsd:string"
    },
    "creator": {
      "@id": "dcterms:creator",
      "@type": "@id"
    },
    "conformsTo": {
      "@id": "dcterms:conformsTo",
      "@type": "@id"
    },
    "recordProfile": {
      "@id": "dcterms:conformsTo",
      "@type": "@id"
    },
