{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["appProfile", "images", "logging", "auth", "s3", "ingress", "apiService", "gateway", "redis"],
  "if": {
    "properties": {
      "auth": {
        "properties": {
          "devWriteTokenSecret": {"minLength": 1}
        }
      }
    }
  },
  "then": {
    "properties": {
      "appProfile": { "type": "string", "const": "dev" },
      "auth": {
        "properties": {
          "issuerUri": { "type": "string", "const": "" },
          "audience": { "type": "string", "const": "" },
          "jwkSetUri": { "type": "string", "const": "" }
        }
      }
    }
  },
  "properties": {
    "appProfile": {
      "description": "APP_PROFILE: prod uses shared Redis quotas and verified JWTs; dev uses local quotas and optionally a development token Secret.",
      "type": "string",
      "enum": ["dev", "prod"]
    },
    "auth": {
      "type": "object",
      "description": "Write authentication. Empty JWT settings keep writes locked unless a dev-only token Secret is configured.",
      "required": ["issuerUri", "audience", "jwkSetUri", "devWriteTokenSecret"],
      "additionalProperties": false,
      "properties": {
        "issuerUri": {"type": "string", "description": "OAUTH2_ISSUER_URI: trusted OAuth2/OIDC issuer; requires audience."},
        "audience": {"type": "string", "description": "OAUTH2_AUDIENCE: expected API audience; requires issuerUri."},
        "jwkSetUri": {"type": "string", "description": "OAUTH2_JWK_SET_URI: optional public-key endpoint; otherwise issuer discovery is used."},
        "devWriteTokenSecret": {"type": "string", "description": "Existing Secret with key DDB_DEV_WRITE_TOKEN, injected into API and gateway. Only appProfile=dev with empty JWT settings; never put the token value in values.yaml."}
      },
      "if": {
        "properties": {
          "issuerUri": {"type": "string", "const": ""}
        }
      },
      "then": {
        "properties": {
          "audience": {"type": "string", "const": ""},
          "jwkSetUri": {"type": "string", "const": ""}
        }
      },
      "else": {
        "properties": {
          "issuerUri": {"type": "string", "pattern": "^https://[^/?#@\\s]+(?:/[^?#\\s]*)?$"},
          "audience": {"type": "string", "pattern": "^\\S+$"},
          "jwkSetUri": {"type": "string", "pattern": "^(?:https://[^/?#@\\s]+(?:/[^?#\\s]*)?)?$"}
        }
      }
    },
    "logging": {
      "type": "object",
      "required": ["accessEnabled"],
      "properties": {
        "accessEnabled": { "type": "boolean" }
      }
    },
    "images": {
      "type": "object",
      "required": ["apiService", "gateway", "pullPolicy"],
      "properties": {
        "apiService": { "$ref": "#/definitions/image" },
        "gateway": { "$ref": "#/definitions/image" },
        "pullPolicy": { "type": "string", "const": "Always" },
        "pullSecrets": { "type": "array", "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1 } } } }
      }
    },
    "s3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "region", "bucket", "pathStyleAccess", "connectionTimeout", "readTimeout", "maxConnections", "createBucket", "existingSecret", "secretKeys"],
      "properties": {
        "endpoint": { "type": "string", "pattern": "^https?://[^/]+/?$", "description": "S3_ENDPOINT: service-account AWS_ENDPOINT_URL, without bucket path or credentials." },
        "region": { "type": "string", "minLength": 1, "description": "S3_REGION: region used for signing requests." },
        "bucket": { "type": "string", "minLength": 3, "maxLength": 63, "description": "S3_BUCKET: bucket provisioned by the storage operator." },
        "pathStyleAccess": { "type": "boolean" },
        "connectionTimeout": { "type": "string", "minLength": 1 },
        "readTimeout": { "type": "string", "minLength": 1 },
        "maxConnections": { "type": "integer", "minimum": 1 },
        "createBucket": { "type": "boolean" },
        "existingSecret": { "type": "string", "minLength": 1, "description": "Name of the operator-managed S3 credential Secret; secretKeys selects its keys. Values never contain the credentials themselves." },
        "secretKeys": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accessKey", "secretKey"],
          "properties": {
            "accessKey": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "description": "Secret key injected as S3_ACCESS_KEY; use AWS_ACCESS_KEY_ID for an existing AWS-named Secret." },
            "secretKey": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "description": "Secret key injected as S3_SECRET_KEY; use AWS_SECRET_ACCESS_KEY for an existing AWS-named Secret." }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "host"],
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string", "minLength": 1 },
        "className": { "type": "string" },
        "tlsSecretName": { "type": "string" }
      }
    },
    "apiService": {
      "type": "object",
      "required": ["replicaCount", "autoscaling", "resources", "forwardHeadersStrategy", "baseUrl", "maxDocumentSize", "concurrency"],
      "properties": {
        "replicaCount": {"$ref": "#/definitions/workload/properties/replicaCount"},
        "forwardHeadersStrategy": {"$ref": "#/definitions/workload/properties/forwardHeadersStrategy"},
        "extraEnv": {"$ref": "#/definitions/workload/properties/extraEnv"},
        "resources": {"$ref": "#/definitions/workload/properties/resources"},
        "autoscaling": {"$ref": "#/definitions/workload/properties/autoscaling"},
        "baseUrl": {"description": "DDB_API_BASE_URL: canonical HTTP(S) origin for RDF IRIs, or auto to use the request origin.", "type": "string", "pattern": "^(?:auto|https?://[^/?#@]+/?)$"},
        "maxDocumentSize": {"type": "string", "minLength": 1, "description": "DDB_API_UPLOAD_MAX_FILE_SIZE: maximum decompressed RDF/XML body size, for example 1MB."},
        "concurrency": {
          "type": "object",
          "required": ["maxRequests", "maxQueuedRequests", "queueTimeout"],
          "properties": {
            "maxRequests": {"type": "integer", "minimum": 1},
            "maxQueuedRequests": {"type": "integer", "minimum": 0},
            "queueTimeout": {"type": "string", "minLength": 1}
          }
        }
      },
      "if": {"$ref": "#/definitions/workload/if"},
      "then": {"$ref": "#/definitions/workload/then"}
    },
    "gateway": {
      "type": "object",
      "required": ["replicaCount", "autoscaling", "resources", "forwardHeadersStrategy", "service", "maxConnections", "rateLimit"],
      "properties": {
        "replicaCount": {"$ref": "#/definitions/workload/properties/replicaCount"},
        "forwardHeadersStrategy": {"$ref": "#/definitions/workload/properties/forwardHeadersStrategy"},
        "extraEnv": {"$ref": "#/definitions/workload/properties/extraEnv"},
        "resources": {"$ref": "#/definitions/workload/properties/resources"},
        "autoscaling": {"$ref": "#/definitions/workload/properties/autoscaling"},
        "maxConnections": {"type": "integer", "minimum": 1, "description": "GATEWAY_HTTP_MAX_CONNECTIONS: upstream connection pool per gateway pod."},
        "rateLimit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capacity", "refillTokens", "refillPeriod", "requestedTokens"],
          "properties": {
            "capacity": {"type": "integer", "minimum": 1, "description": "RATE_LIMIT_BURST_CAPACITY: maximum tokens per client bucket."},
            "refillTokens": {"type": "integer", "minimum": 1, "description": "RATE_LIMIT_REPLENISH_RATE: tokens added each refill period."},
            "refillPeriod": {"type": "string", "minLength": 1, "description": "RATE_LIMIT_REFILL_PERIOD: refill duration, for example 1s."},
            "requestedTokens": {"type": "integer", "minimum": 1, "description": "RATE_LIMIT_REQUESTED_TOKENS: token cost of one request."}
          }
        },
        "service": {
          "type": "object",
          "required": ["type", "port"],
          "properties": {
            "type": {"type": "string", "enum": ["ClusterIP", "LoadBalancer", "NodePort"]},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        }
      },
      "if": {"$ref": "#/definitions/workload/if"},
      "then": {"$ref": "#/definitions/workload/then"}
    },
    "redis": {
      "type": "object",
      "required": ["image", "auth", "serviceAccount", "extraSecretRedisConfigs", "extraSecretSentinelConfigs", "haMode", "storage", "useDeploymentWhenNonHA"],
      "properties": {
        "useDeploymentWhenNonHA": { "type": "boolean", "const": false },
        "image": {
          "type": "object",
          "required": ["registry", "repository", "tag", "pullPolicy"],
          "properties": {
            "registry": { "type": "string", "minLength": 1 },
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "const": "Always" }
          }
        },
        "auth": {
          "type": "object",
          "required": ["username", "secretName"],
          "properties": {
            "username": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "not": { "enum": ["default", "replication", "sentinel-admin"] } },
            "secretName": { "type": "string", "minLength": 1 }
          }
        },
        "serviceAccount": {
          "type": "object",
          "required": ["create", "name"],
          "properties": {
            "create": { "type": "boolean", "const": false },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        "extraSecretRedisConfigs": { "type": "string", "minLength": 1 },
        "extraSecretSentinelConfigs": { "type": "string", "minLength": 1 },
        "haMode": {
          "type": "object",
          "required": ["enabled", "masterGroupName", "replicas", "quorum"],
          "properties": {
            "enabled": {"type": "boolean"},
            "masterGroupName": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
            "replicas": {"type": "integer", "minimum": 1},
            "quorum": {"type": "integer", "minimum": 1}
          },
          "if": {
            "properties": {
              "enabled": { "type": "boolean", "const": true }
            }
          },
          "then": {
            "properties": {
              "replicas": {"minimum": 3},
              "quorum": {"minimum": 2}
            }
          }
        },
        "storage": {
          "type": "object",
          "required": ["requestedSize", "persistentVolumeClaimRetentionPolicy"],
          "properties": {
            "requestedSize": { "type": "string", "minLength": 1 },
            "persistentVolumeClaimRetentionPolicy": {
              "type": "object",
              "required": ["whenScaled", "whenDeleted"],
              "properties": {
                "whenScaled": { "type": "string", "const": "Retain" },
                "whenDeleted": { "type": "string", "const": "Retain" }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 }
      }
    },
    "workload": {
      "type": "object",
      "required": ["replicaCount", "autoscaling", "resources", "forwardHeadersStrategy"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 1},
        "forwardHeadersStrategy": {"type": "string", "enum": ["none", "native", "framework"], "description": "SERVER_FORWARD_HEADERS_STRATEGY for this pod. Enable only behind a trusted proxy that sanitizes forwarded headers."},
        "extraEnv": {
          "type": "object",
          "description": "Additional native Spring environment overrides for this workload, for example JAVA_TOOL_OPTIONS. Keep credentials in Secrets.",
          "additionalProperties": {"type": ["string", "number", "boolean"]}
        },
        "resources": {"type": "object"},
        "autoscaling": {
          "type": "object",
          "required": ["enabled", "minReplicas", "maxReplicas", "targetCPUUtilizationPercentage"],
          "properties": {
            "enabled": {"type": "boolean"},
            "minReplicas": {"type": "integer", "minimum": 1},
            "maxReplicas": {"type": "integer", "minimum": 1},
            "targetCPUUtilizationPercentage": {"type": "integer", "minimum": 1}
          }
        }
      },
      "if": {
        "properties": {
          "autoscaling": {
            "properties": {
              "enabled": { "type": "boolean", "const": true }
            }
          }
        }
      },
      "then": {
        "properties": {
          "resources": {
            "required": ["requests"],
            "properties": {
              "requests": {
                "type": "object",
                "required": ["cpu"],
                "properties": {
                  "cpu": {
                    "description": "CPU utilization HPA needs a positive CPU request.",
                    "oneOf": [
                      {"type": "number", "exclusiveMinimum": 0},
                      {"type": "string", "pattern": "^[+0-9.]*[1-9]"}
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
