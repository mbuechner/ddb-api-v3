{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["images", "logging", "auth", "s3", "ingress", "apiService", "gateway", "redis"],
  "properties": {
    "auth": {
      "type": "object",
      "required": ["issuerUri", "audience", "jwkSetUri"],
      "additionalProperties": false,
      "properties": {
        "issuerUri": { "type": "string" },
        "audience": { "type": "string" },
        "jwkSetUri": { "type": "string" }
      },
      "oneOf": [
        {
          "properties": {
            "issuerUri": { "const": "" },
            "audience": { "const": "" },
            "jwkSetUri": { "const": "" }
          }
        },
        {
          "properties": {
            "issuerUri": { "pattern": "^https://[^/?#@\\s]+(?:/[^?#\\s]*)?$" },
            "audience": { "pattern": "^\\S+$" },
            "jwkSetUri": {
              "oneOf": [
                { "const": "" },
                { "pattern": "^https://[^/?#@\\s]+(?:/[^?#\\s]*)?$" }
              ]
            }
          }
        }
      ]
    },
    "logging": {
      "type": "object",
      "required": ["accessEnabled"],
      "properties": {
        "accessEnabled": { "type": "boolean" }
      }
    },
    "images": {
      "type": "object",
      "required": ["apiService", "gateway", "pullPolicy"],
      "properties": {
        "apiService": { "$ref": "#/definitions/image" },
        "gateway": { "$ref": "#/definitions/image" },
        "pullPolicy": { "const": "Always" },
        "pullSecrets": { "type": "array" }
      }
    },
    "s3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "region", "bucket", "pathStyleAccess", "connectionTimeout", "readTimeout", "maxConnections", "createBucket", "existingSecret"],
      "properties": {
        "endpoint": { "type": "string", "pattern": "^https?://[^/]+/?$" },
        "region": { "type": "string", "minLength": 1 },
        "bucket": { "type": "string", "minLength": 3, "maxLength": 63 },
        "pathStyleAccess": { "type": "boolean" },
        "connectionTimeout": { "type": "string", "minLength": 1 },
        "readTimeout": { "type": "string", "minLength": 1 },
        "maxConnections": { "type": "integer", "minimum": 1 },
        "createBucket": { "type": "boolean" },
        "existingSecret": { "type": "string", "minLength": 1 }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "host"],
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string", "minLength": 1 },
        "className": { "type": "string" },
        "tlsSecretName": { "type": "string" }
      }
    },
    "apiService": {
      "allOf": [
        { "$ref": "#/definitions/workload" },
        {
          "type": "object",
          "required": ["baseUrl", "concurrency"],
          "properties": {
            "baseUrl": {
              "description": "Explicit canonical HTTP(S) origin, or auto to use the request origin.",
              "type": "string",
              "oneOf": [
                { "const": "auto" },
                { "pattern": "^https?://[^/?#@]+/?$" }
              ]
            },
            "concurrency": {
              "type": "object",
              "required": ["maxRequests", "maxQueuedRequests", "queueTimeout"],
              "properties": {
                "maxRequests": { "type": "integer", "minimum": 1 },
                "maxQueuedRequests": { "type": "integer", "minimum": 0 },
                "queueTimeout": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      ]
    },
    "gateway": {
      "allOf": [
        { "$ref": "#/definitions/workload" },
        {
          "type": "object",
          "required": ["service", "maxConnections"],
          "properties": {
            "maxConnections": { "type": "integer", "minimum": 1 },
            "service": {
              "type": "object",
              "required": ["type", "port"],
              "properties": {
                "type": { "type": "string", "enum": ["ClusterIP", "LoadBalancer", "NodePort"] },
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
              }
            }
          }
        }
      ]
    },
    "redis": {
      "type": "object",
      "required": ["image", "auth", "serviceAccount", "extraSecretRedisConfigs", "extraSecretSentinelConfigs", "haMode", "storage", "useDeploymentWhenNonHA"],
      "properties": {
        "useDeploymentWhenNonHA": { "const": false },
        "image": {
          "type": "object",
          "required": ["registry", "repository", "tag", "pullPolicy"],
          "properties": {
            "registry": { "type": "string", "minLength": 1 },
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "const": "Always" }
          }
        },
        "auth": {
          "type": "object",
          "required": ["username", "secretName"],
          "properties": {
            "username": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "not": { "enum": ["default", "replication", "sentinel-admin"] } },
            "secretName": { "type": "string", "minLength": 1 }
          }
        },
        "serviceAccount": {
          "type": "object",
          "required": ["create", "name"],
          "properties": {
            "create": { "const": false },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        "extraSecretRedisConfigs": { "type": "string", "minLength": 1 },
        "extraSecretSentinelConfigs": { "type": "string", "minLength": 1 },
        "haMode": {
          "type": "object",
          "required": ["enabled", "masterGroupName", "replicas", "quorum"],
          "properties": {
            "enabled": { "type": "boolean" },
            "masterGroupName": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
            "replicas": { "type": "integer", "minimum": 1 },
            "quorum": { "type": "integer", "minimum": 1 }
          },
          "allOf": [
            {
              "if": { "properties": { "enabled": { "const": true } } },
              "then": {
                "properties": {
                  "replicas": { "minimum": 3 },
                  "quorum": { "minimum": 2 }
                }
              }
            }
          ]
        },
        "storage": {
          "type": "object",
          "required": ["requestedSize", "persistentVolumeClaimRetentionPolicy"],
          "properties": {
            "requestedSize": { "type": "string", "minLength": 1 },
            "persistentVolumeClaimRetentionPolicy": {
              "type": "object",
              "required": ["whenScaled", "whenDeleted"],
              "properties": {
                "whenScaled": { "const": "Retain" },
                "whenDeleted": { "const": "Retain" }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 }
      }
    },
    "workload": {
      "type": "object",
      "required": ["replicaCount", "autoscaling", "resources"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "extraEnv": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
        "resources": { "type": "object" },
        "autoscaling": {
          "type": "object",
          "required": ["enabled", "minReplicas", "maxReplicas", "targetCPUUtilizationPercentage"],
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 },
            "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "autoscaling": { "properties": { "enabled": { "const": true } } } } },
          "then": {
            "properties": {
              "resources": {
                "required": ["requests"],
                "properties": {
                  "requests": {
                    "type": "object",
                    "required": ["cpu"],
                    "properties": {
                      "cpu": {
                        "description": "CPU utilization HPA needs a positive CPU request.",
                        "oneOf": [
                          { "type": "number", "exclusiveMinimum": 0 },
                          { "type": "string", "pattern": "^[+0-9.]*[1-9]" }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
